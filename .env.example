# ============================================================
# Azure Document Intelligence
# ============================================================

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DI-RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=YOUR_DOCUMENT_INTELLIGENCE_KEY
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DI-RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=YOUR_DOCUMENT_INTELLIGENCE_KEY


# ============================================================
# Azure OpenAI
# ============================================================

AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY

# This is the deployment name, NOT necessarily the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o

AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# ============================================================
# Azure Blob Storage
# ============================================================

AZURE_STORAGE_CONNECTION_STRING=YOUR_STORAGE_CONNECTION_STRING
AZURE_STORAGE_CONNECTION_STRING=YOUR_STORAGE_CONNECTION_STRING

AZURE_STORAGE_INPUT_CONTAINER=input
AZURE_STORAGE_OUTPUT_CONTAINER=processed
AZURE_STORAGE_REPORT_CONTAINER=reports


# ============================================================
# Application
# ============================================================

CONFIDENCE_THRESHOLD=0.80

MAX_RETRIES=3
RETRY_MIN_SECONDS=1
RETRY_MAX_SECONDS=8

LOG_LEVEL=INFO

# Optional: receive JSON notifications when an agent fails.
# ERROR_NOTIFICATION_WEBHOOK_URL=https://example.com/document-failures